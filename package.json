{
  "name": "fhn-operations",
  "version": "1.0.0",
  "private": true,
  "description": "FHN AI — one live room-state layer for Founders Hotel Network: room readiness, staffing, maintenance and room climate, plus the guest app (Pitch the Future 2026 prototype)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch server/src/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/src/index.ts",
    "demo": "vite build && tsx server/src/index.ts --open",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "^4.21.2",
    "postgres": "^3.4.9",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
