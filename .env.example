# Copy to .env and fill in. .env is git-ignored — never commit real credentials.

# ── Real SMS via Twilio ────────────────────────────────────────────────
# Custom text ("Room 504 is ready") needs an UPGRADED Twilio account.
# Free trial accounts can only send Twilio's canned templates to verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number in E.164 (buy a Canadian local number with SMS), e.g. +16475550199
TWILIO_FROM=
# …or use a Messaging Service instead of TWILIO_FROM
# TWILIO_MESSAGING_SERVICE_SID=
# Trial only: name of a Twilio template to send instead of custom text (pipeline test only)
# TWILIO_TRIAL_TEMPLATE=sms_appointment_reminders

# ── Free fallback: push notification via the ntfy app (not SMS) ────────
# Install "ntfy" on the stage phone, subscribe to this topic. Pick something hard to guess.
# NTFY_TOPIC=fhn-readypath-change-me-7c41
# NTFY_SERVER=https://ntfy.sh

# ── Stage mode ("Mike") ────────────────────────────────────────────────
STAGE_NAME=Mike
STAGE_ROOM=504
# The phone that receives the on-stage text, e.g. 416 555 0123
STAGE_PHONE=
# Lock the stage controls when the app is on a public URL (recommended)
# STAGE_PIN=2468

# ── Safety caps (protect your SMS credit) ──────────────────────────────
SMS_MAX_PER_HOUR=60
SMS_MAX_PER_GUEST_PER_HOUR=8

# Hotel time zone for stage message times
HOTEL_TIME_ZONE=America/Toronto
# Public URL used in notification links (optional; auto-detected otherwise)
# PUBLIC_URL=https://your-app.onrender.com
